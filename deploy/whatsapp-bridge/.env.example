# Copiar para /var/www/fontesan/deploy/whatsapp-bridge/.env na VPS e preencher.

PORT=3000
HOST=127.0.0.1
WHATSAPP_AUTH_DIR=/var/www/fontesan/deploy/whatsapp-bridge/auth_state
LOG_LEVEL=warn

# So-digitos, com DDI (ex. 5511999999999). Varios separados por virgula.
# "*" libera geral -- so usar depois de validar com numero(s) de teste.
# Comecar restrito (ex. so o proprio numero de teste) enquanto a base de
# conhecimento "fontesan" ainda esta em revisao.
WHATSAPP_ALLOWED_USERS=

# Aponta para o backend supportfaqagent nesta mesma VPS.
HERMES_CHAT_FORWARD_URL=http://127.0.0.1:8000/integrations/hermes/chat/webhook

# Mesmo valor de HERMES_CHAT_FORWARD_SECRET no .env do backend
# (/var/www/fontesan/backend/.env). Gerar com: openssl rand -hex 32
HERMES_CHAT_FORWARD_SECRET=
